# hermes webui — session management and a chat box.
#
# Two venvs on purpose. hermes and this app share most of their dependencies and
# disagree on some, so one venv would resolve to whatever the later install
# wanted and quietly break the other. `hermes_session_api.py` is executed by
# HERMES' interpreter for exactly the same reason.
#
# Retrieval still goes through `memory-mcp` over HTTP MCP. Media does not: the
# app stores images and generated video in autumn through the PyO3 client,
# built here from the autumn-rs image's own sources.
#
# That client IS the wire format, so this image is now bound to autumn's WIRE
# lockstep: AUTUMN_IMAGE must name the same commit as the running cluster, and
# a wire bump requires rebuilding this image with it. A mismatch does not fail
# the handshake — it decodes garbage. The alternative was a FUSE mount, which
# keeps the image unbound but puts the kernel in the path of every byte for a
# whole-file read that wants one round trip; measured on this cluster, a FUSE
# read costs ~2 ms of round trip plus the kernel's own overhead either way.
#
#   kubectl -n autumn get sts autumn-ps \
#     -o jsonpath='{.spec.template.spec.containers[0].image}'   # the tag to pass

# The autumn commit whose client this image carries. It MUST be the one the
# cluster runs; see the note at the top.
#
# Sources from codeload, not `FROM <private registry>/autumn-rs:<sha>`. The
# image carries them at /usr/local/share/autumn/src and pulling that way is how
# Dockerfile.freetoken-l3 does it — but that one is built by hand with
# credentials, and this pipeline's builder has none for the private registry:
# it PUSHES there, it does not pull. One GET against codeload either works or
# fails loudly, and it makes the wire pin a git sha you can check out.
ARG AUTUMN_SHA=947bae0396481fe9e8586aae7eefa98852d2247d
ARG AUTUMN_SPEC=https://codeload.github.com/journeymidnight/autumn-rs/tar.gz/${AUTUMN_SHA}
# crates.io mirror for the wheel build. Defaulted, not empty: the CN build pool
# reaches crates.io slowly enough that the wheel step times out without it.
ARG CARGO_MIRROR=sparse+https://rsproxy.cn/index/

ARG BASE_REGISTRY=
# `library/` spelled out, not the bare `python:` Docker Hub lets you write.
# BASE_REGISTRY points this at a Hub cache in CI, and that cache rejects a
# repository name with no namespace as malformed — a build there dies in
# resolveBaseImage before running a single instruction, while the same
# Dockerfile builds fine on a laptop. Docker Hub accepts both spellings, so the
# explicit one is the one that works in both places.
ARG PYTHON_IMAGE=library/python:3.12-slim-bookworm
FROM ${BASE_REGISTRY}${PYTHON_IMAGE}

ARG APT_MIRROR=
# The default index resolves pypi.org but pulls wheels from files.hosted, which
# stalls from the CN build pool with no output rather than failing. Same trap
# `Dockerfile.freetoken` documents.
ARG PIP_INDEX_URL=https://pypi.org/simple/
ARG HERMES_VERSION=0.17.0
ARG HERMES_EXTRA_INDEX=

ENV PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN set -eux; \
    if [ -n "${APT_MIRROR}" ]; then \
      sed -i "s|http://deb.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list.d/debian.sources || true; \
    fi; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl git tini; \
    rm -rf /var/lib/apt/lists/*

# --- hermes, in its own venv ------------------------------------------------ #
# `hermes acp --check` at BUILD time: an image whose agent cannot start should
# fail here, not at 3am in a rollout. It is also the only cheap proof that the
# `[acp]` extra actually resolved.
RUN set -eux; \
    python -m pip install --no-cache-dir uv; \
    uv venv /opt/hermes/.venv; \
    VIRTUAL_ENV=/opt/hermes/.venv uv pip install --no-cache-dir \
        $( [ -n "${HERMES_EXTRA_INDEX}" ] && echo "--extra-index-url ${HERMES_EXTRA_INDEX} --index-strategy unsafe-best-match" ) \
        "hermes-agent[acp,mcp]==${HERMES_VERSION}"; \
    ln -sf /opt/hermes/.venv/bin/hermes /usr/local/bin/hermes; \
    hermes acp --check

# Let HERMES_ACP_TOOLSETS choose a session's toolsets. Runs in the HERMES venv,
# where acp_adapter lives. Idempotent, and a no-op if hermes moved the call --
# a failed patch must not fail the build, the image just keeps the tools it had.
COPY webui/scripts/patch_acp_toolsets.py /tmp/patch_acp_toolsets.py
RUN /opt/hermes/.venv/bin/python /tmp/patch_acp_toolsets.py && rm /tmp/patch_acp_toolsets.py

# --- autumn's PyO3 client --------------------------------------------------- #
# The wheel goes into HERMES' venv, not the system one: `main.py` runs under
# that interpreter, so that is where `import autumn` has to resolve.
#
# `test -f` right after the untar, because a codeload 404 for a bad sha returns
# a valid gzip of an error page and `tar xz` is happy with it — the build would
# then fail thousands of lines later inside cargo, about a missing manifest.
ARG AUTUMN_SPEC
RUN set -eux; \
    mkdir -p /autumn-src; \
    curl -fsSL "${AUTUMN_SPEC}" | tar xz --strip-components=1 -C /autumn-src; \
    test -f /autumn-src/python/Cargo.toml; \
    curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal; \
    . /root/.cargo/env; \
    if [ -n "${CARGO_MIRROR}" ]; then \
      mkdir -p /root/.cargo; \
      printf '[source.crates-io]\nreplace-with = "m"\n[source.m]\nregistry = "%s"\n' "${CARGO_MIRROR}" > /root/.cargo/config.toml; \
    fi; \
    /opt/hermes/.venv/bin/python -m pip install --no-cache-dir "maturin>=1,<2"; \
    cd /autumn-src/python; \
    /opt/hermes/.venv/bin/maturin build --release --interpreter /opt/hermes/.venv/bin/python --out /wheels; \
    /opt/hermes/.venv/bin/python -m pip install --no-cache-dir /wheels/*.whl; \
    /opt/hermes/.venv/bin/python -c "import autumn; print('autumn client ok')"; \
    rm -rf /root/.cargo /root/.rustup /autumn-src /wheels

# --- the app ---------------------------------------------------------------- #
RUN python -m pip install --no-cache-dir "aiohttp>=3.9"

WORKDIR /app
COPY webui/ /app/

ENV HERMES_BIN=/usr/local/bin/hermes \
    HERMES_PY=/opt/hermes/.venv/bin/python \
    HERMES_HOME=/opt/data \
    HERMES_DISABLE_LAZY_INSTALLS=1 \
    # The other half of disabling a toolset. Availability is computed for EVERY
    # toolset and filtered afterwards, so the browser toolset's lazy installer
    # still fires during the check even when the toolset is off -- a fresh
    # volume elsewhere grew 220 KB -> 897 MB pulling Chromium it would never use.
    HERMES_NO_DEP_INSTALL=1 \
    WORKDIR=/opt/data \
    PORT=8080 \
    MEMORY_MCP_URL=http://memory-mcp:5100/mcp
RUN mkdir -p /opt/data/logs

EXPOSE 8080
# tini reaps: `hermes acp` is a child of this process, and a chat session that
# ends without one leaves a zombie per turn. The lerobot console learned this by
# accumulating 48 of them over 26 hours.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "server.py"]
